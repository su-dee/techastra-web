# Copy this file to .env and fill in real values before running the server.

# Postgres connection string (Replit's built-in Postgres/Neon integration)
DATABASE_URL="postgresql://user:password@host:5432/techastra?schema=public"

# JWT signing secret - at least 32 random characters in production, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET="replace-this-with-a-long-random-secret"
JWT_EXPIRES_IN="7d"
# Staff (non-participant) sessions are shorter; roles are re-checked on every request anyway.
STAFF_JWT_EXPIRES_IN="12h"

# Server
# "production" turns on HSTS, strict CORS and start-up config checks.
NODE_ENV=development
PORT=4000
# Deployed frontend URL(s), comma-separated, e.g. https://register.example.in
CLIENT_ORIGIN="http://localhost:5173"
# Reverse-proxy hops to trust for the client IP (rate limits). Defaults to 1
# in production, 0 locally.
# TRUST_PROXY=1

# UPI details for the optional /api/upi/qr route. Checkout uses the static QR
# image in client/src/assets/upi-qr.png (UPI_ID in client/src/lib/site.js).
UPI_PAYEE_ID="college@upi"
UPI_PAYEE_NAME="TechAstra Symposium"

# Razorpay (OPTIONAL - checkout uses UPI QR). The /api/payment routes are
# only enabled when both keys are set.
# Get these from your Razorpay Dashboard: https://dashboard.razorpay.com/
# IMPORTANT: KEY_SECRET must NEVER be exposed to frontend - server-only
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""

# Email (optional) - the approval email is the only automatic email. It is
# sent by php-mailer/send.php on the website host with PHP mail(): no SMTP
# account, no paid service. See php-mailer/README.md. If left blank, the
# email is printed to the console instead.
#   MAIL_ENDPOINT_URL=https://your-domain/php-mailer/send.php
#   MAIL_ENDPOINT_SECRET = same value as SECRET in php-mailer/config.php,
#     e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Or, on a host with no PHP site: the server's own sendmail (what PHP mail() uses).
# MAIL_TRANSPORT=sendmail
# MAIL_FROM=no-reply@techastra.drmgrdu.ac.in
# MAIL_REPLY_TO=techastra@drmgrdu.ac.in
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
MAIL_ENDPOINT_URL=""
MAIL_ENDPOINT_SECRET=""

# Hack Nexus at /hacknexus, run inside this server (production on Plesk).
# Its settings are HN_-prefixed; it never reads this file's other values.
# HACKNEXUS_EMBEDDED=1
# HN_DATABASE_URL="postgresql://…pooler.supabase.com:5432/postgres"
# HN_DB_SCHEMA=hacknexus
# HN_DB_SSL=1
# HN_DB_POOL_MAX=5
# HN_APP_ORIGIN=https://techastra.drmgrdu.ac.in
# HN_SMTP_HOST= HN_SMTP_PORT= HN_SMTP_USER= HN_SMTP_PASS= HN_MAIL_FROM= HN_MAIL_REPLY_TO=
# HN_REGISTRATION_FEE=1000 HN_UPI_ID= HN_UPI_PAYEE_NAME=
