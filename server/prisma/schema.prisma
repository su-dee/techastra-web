// TechAstra Symposium Portal - Prisma schema
// Run `npx prisma migrate dev --name init` after setting DATABASE_URL in .env

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String   @unique
  phone            String?
  passwordHash     String
  role             String   // participant | registration_team | coordinator | hospitality | certificate_team | junior_coordinator | master_admin
  collegeName      String?
  registerNo       String?
  // College students (senior events): course, department and year of study
  course           String?
  department       String?
  yearOfStudy      String?  // "1st Year" | "2nd Year" | "3rd Year" | "4th Year"
  photoUrl         String?
  assignedEventId  String?  // for coordinators
  dutyDesk         String?  // unused: volunteer role removed (kept to avoid a migration)
  dutyTiming       String?  // unused
  dutyRole         String?  // unused
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  assignedEvent    Event?   @relation(fields: [assignedEventId], references: [id])
  registration     Registration? @relation("UserRegistration")

  @@index([role])
}

model Event {
  id            String   @id @default(cuid())
  name          String
  description   String
  track         String?
  category      String   @default("technical") // technical | non_technical
  level         String   @default("senior") // senior (college students) | junior (school students)
  day           Int?     // 1 or 2 (Day 1 or Day 2 of the symposium)
  startTime     DateTime
  endTime       DateTime
  fee           Float
  // false: fee is per person (x team size); true: a flat fee per team (Hack Nexus)
  feePerTeam    Boolean  @default(false)
  // true: registration happens on a separate website (Hack Nexus) - the
  // portal links out to registrationUrl and never takes it in the cart.
  externalRegistration Boolean @default(false)
  registrationUrl      String?
  // The event's WhatsApp group invite. Only approved participants of the
  // event get it (approval email, dashboard) - never in the public list.
  whatsappUrl          String?
  // Options a participant must pick one of when registering, e.g. the game
  // for Clash Squad E-Sports (["Free Fire Max", "BGMI"]), and what to call
  // the choice ("Game"). Empty: nothing to choose.
  choices              String[] @default([])
  choiceLabel          String?
  maxSeats      Int
  // Seats kept for on-spot registration on the event day (desk QR): online
  // registration can only fill maxSeats - onSpotSeats. 0: no quota.
  onSpotSeats   Int      @default(0)
  seatsTaken    Int      @default(0)
  isTeamEvent   Boolean  @default(false)
  minTeamSize   Int      @default(1)
  maxTeamSize   Int      @default(1)
  rulebook      String?
  venue         String?
  // Display-only contact info shown on the Event Detail page (name/role/
  // phone per person) - NOT the same thing as `coordinators` below, which
  // is real coordinator USER ACCOUNTS used for login/auth/QR-scanning
  // permissions. This field is deliberately a separate, unrelated column
  // so it never collides with that relation. Shape: an array of
  // { name: string, role: string, phone: string } - variable length,
  // since some events have 1 coordinator and others have several.
  // Defaults to an empty array so existing events created before this
  // field existed don't break (no coordinator contacts shown, not a
  // crash) until real data is filled in.
  coordinatorContacts Json @default("[]")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  coordinators  User[]

  @@index([startTime])
}

model Registration {
  id                String   @id @default(cuid())
  registrationCode  String   @unique // e.g. SYM2026-0042
  userId            String   @unique
  eventIds          String[] // array of Event ids
  teamName          String?
  teamMembers       Json?    // [{name, regNo, role: "lead"|"member"}]
  // The option picked for each event that has choices: { [eventId]: "BGMI" }
  eventChoices      Json?
  // Registered on the spot (the desk's on-spot QR or its cash form): may
  // use an event's on-spot seats, and pays in cash at the desk.
  onSpot            Boolean  @default(false)
  collegeName       String?
  totalAmount       Float
  transactionId     String?  @unique
  paymentProofUrl   String?
  paymentMethod     String   @default("upi") // upi | razorpay | cash
  razorpayOrderId   String?  // Razorpay order ID for online payments
  razorpayPaymentId String?  // Razorpay payment ID after successful payment
  status            String   @default("pending") // pending | approved | rejected
  rejectionReason   String?
  // Who approved/rejected/changed the status, and when (audit trail). The
  // name is a snapshot so it survives the staff account being deleted.
  reviewedById      String?
  reviewedByName    String?
  reviewedAt        DateTime?
  // DPDP Act 2023: when the participant accepted the Terms and Privacy
  // Notice, and (Junior Techastra, participants under 18) that a parent or
  // guardian consented.
  consentAt         DateTime?
  guardianConsent   Boolean  @default(false)
  // "Mr" | "Ms" for each person on the certificates, by their place in the
  // team list (0 = the registrant). Picked on the dashboard; "" = not set.
  memberTitles      String[] @default([])
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user              User     @relation("UserRegistration", fields: [userId], references: [id])

  @@index([status])
}

// Junior Techastra: school students are registered by the overall Junior
// coordinator importing an Excel/CSV file (one student per row, per event).
// No account, phone, email, ID card, QR check-in or certificate. Students
// with the same team name and school in one event form a team. Results for
// junior events store one of these ids (the team's first member) as
// Result.registrationId.
model JuniorParticipant {
  id             String   @id @default(cuid())
  code           String   @unique // JR2026-0001
  eventId        String
  name           String
  school         String
  className      String
  teamName       String?
  importedById   String
  importedByName String
  createdAt      DateTime @default(now())

  @@index([eventId])
}

model Attendance {
  id             String   @id @default(cuid())
  registrationId String
  eventId        String
  scannedAt      DateTime @default(now())
  scannedBy      String   // coordinator user id

  @@unique([registrationId, eventId])
}

model FoodLog {
  id             String   @id @default(cuid())
  registrationId String
  mealSession    String   // breakfast | lunch | snacks
  collectedAt    DateTime @default(now())

  @@unique([registrationId, mealSession])
}

// Welcome kits handed out at the registration desk: one row per registration
// (kits = everyone on it), so a second scan can't collect them again. The
// staff name is a snapshot so it survives the account being deleted.
model KitHandout {
  id             String   @id @default(cuid())
  registrationId String   @unique
  kits           Int
  givenById      String
  givenByName    String
  givenAt        DateTime @default(now())

  @@index([givenAt])
}

model Result {
  id              String   @id @default(cuid())
  eventId         String
  position        Int      // 1, 2, 3
  registrationId  String
  lockedBy        String   // coordinator user id
  lockedAt        DateTime @default(now())
  overriddenBy    String?  // master admin user id, if edited

  @@unique([eventId, position])
}

model Certificate {
  id              String   @id @default(cuid())
  certificateCode String   @unique
  registrationId  String
  eventId         String
  type            String   // participation | winner
  // Whose certificate: the person's place in the team list (0 = the
  // registrant), and the name printed on it. Each team member gets their own.
  memberIndex     Int      @default(0)
  recipientName   String?
  // The PDF's file name in uploads/certificates (served only through
  // GET /api/certificates/:code/pdf, never publicly).
  pdfUrl          String?
  // Participation certificates are emailed to the registrant at the end of
  // the event day; winner certificates are printed by the committee only.
  emailedAt       DateTime?
  issuedAt        DateTime @default(now())

  @@unique([registrationId, eventId, type, memberIndex])
}

model Announcement {
  id        String   @id @default(cuid())
  message   String
  createdAt DateTime @default(now())
  createdBy String
}

model Feedback {
  id        String   @id @default(cuid())
  eventId   String
  userId    String?
  rating    Int
  comments  String?
  createdAt DateTime @default(now())
}

model HelpQuery {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  status    String   @default("open") // open | resolved
  createdAt DateTime @default(now())
}

model ComboPass {
  id              String   @id @default(cuid())
  name            String
  description     String
  eventIds        String[] // Array of Event IDs included in this combo
  individualPrice Float    // Sum of individual event prices
  comboPrice      Float    // Discounted combo price
  savings         Float    // individualPrice - comboPrice
  category        String   // "mixed" for cross-category combos
  availableSeats  Int
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
}
