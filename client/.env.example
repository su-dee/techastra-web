# Copy to .env (local) or set in Vercel's Environment Variables (production).

# Base URL of the API (techweb/server). Production example:
#   VITE_API_URL=https://techastra-api.onrender.com
# If you change the API host, also update the connect-src / img-src hosts in
# client/vercel.json (Content-Security-Policy).
VITE_API_URL=http://localhost:4000

# Public URL of this portal, no trailing slash. Used for canonical and Open
# Graph URLs, sitemap.xml and security.txt at build time.
VITE_SITE_URL=http://localhost:5173
