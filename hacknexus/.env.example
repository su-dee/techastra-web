DATABASE_URL=postgresql://hacknexus:hacknexus_local@localhost:5432/hacknexus
PORT=3001
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# Enable only behind a trusted reverse proxy:
TRUST_PROXY=0
# Squad payment (UPI). Defaults match the organizer QR; change here if needed.
REGISTRATION_FEE=1000
UPI_ID=7010826253-2@ybl
UPI_PAYEE_NAME=THIRUVENKATAM V
# Approval emails to the squad lead (optional). Any SMTP provider works; Gmail is free:
# turn on 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_REPLY_TO=

# Hosted database (e.g. Supabase, shared with the Techastra site): keep Hack
# Nexus in its own schema, connect over SSL, keep the pool small.
# Use the session pooler URL (port 5432) with ?sslmode=require as DATABASE_URL.
# DB_SCHEMA=hacknexus
# DB_SSL=1
# DB_POOL_MAX=5
