{
  "name": "hack-nexus",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node --watch --env-file-if-exists=.env server/index.js\" \"vite --host 127.0.0.1\"",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "admin:create": "node --env-file-if-exists=.env server/admin-cli.js create",
    "admin:remove": "node --env-file-if-exists=.env server/admin-cli.js remove",
    "test": "npm run build && node --test tests/*.test.js",
    "dev:local": "node server/local-db.js --with-app",
    "db:local": "node server/local-db.js",
    "test:postgres": "node tests/postgres-live.js",
    "format": "prettier --write src server tests vite.config.js index.html package.json"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.0",
    "helmet": "^8.1.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.468.0",
    "nodemailer": "^10.0.12",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.0",
    "embedded-postgres": "^18.4.0-beta.17",
    "prettier": "^3.9.9",
    "supertest": "^7.1.0",
    "vite": "^7.0.0"
  }
}
